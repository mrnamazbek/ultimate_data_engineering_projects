# Postgres
POSTGRES_USER=deuser
POSTGRES_PASSWORD=depassword
POSTGRES_DB=dedb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Kafka
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC=events
PRODUCER_RATE=1  # events per second

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=raw-events

# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://deuser:depassword@postgres/airflow
AIRFLOW__CORE__FERNET_KEY=changeme_generate_with_fernet
AIRFLOW__WEBSERVER__SECRET_KEY=changeme_webserver_secret

# Model API
MODEL_PATH=/models/model.pkl
