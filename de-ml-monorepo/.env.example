# Postgres
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=dedb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Kafka
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC=events
PRODUCER_RATE=1

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=your_minio_user
MINIO_SECRET_KEY=your_minio_password
MINIO_BUCKET=raw-events

# Airflow (3.1.6)
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://your_db_user:your_db_password@postgres/dedb
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key_here
AIRFLOW_ADMIN_USER=your_airflow_user
AIRFLOW_ADMIN_PASSWORD=your_airflow_password

# Superset
SUPERSET_SECRET_KEY=your_superset_secret_key

# Model API
MODEL_PATH=/models/model.pkl

# Hadoop & HDFS
HDFS_NAMENODE=namenode:8020
HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop

# Flink
FLINK_JOBMANAGER=flink-jobmanager:8081
FLINK_PARALLELISM=2

# Big Data Generation
BIG_DATA_RATE=100
DATA_VOLUME_GB=10
