# Postgres
POSTGRES_USER=namazbek
POSTGRES_PASSWORD=bekzhanov
POSTGRES_DB=dedb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Kafka
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC=events
PRODUCER_RATE=1

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=namazbek
MINIO_SECRET_KEY=bekzhanov
MINIO_BUCKET=raw-events

# Airflow (3.1.6)
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://namazbek:bekzhanov@postgres/dedb
AIRFLOW__CORE__FERNET_KEY=changeme_generate_with_fernet
AIRFLOW__WEBSERVER__SECRET_KEY=changeme_webserver_secret
AIRFLOW_ADMIN_USER=namazbek
AIRFLOW_ADMIN_PASSWORD=bekzhanov

# Superset
SUPERSET_SECRET_KEY=superset_dev_secret_change_me

# Model API
MODEL_PATH=/models/model.pkl

# Hadoop & HDFS
HDFS_NAMENODE=namenode:8020
HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop

# Flink
FLINK_JOBMANAGER=flink-jobmanager:8081
FLINK_PARALLELISM=2

# Big Data Generation
BIG_DATA_RATE=100
DATA_VOLUME_GB=10
